# Template only. Copy the generated file to dozzle/users.yml on the VPS.
# Never commit dozzle/users.yml (it is gitignored).
#
# Generate the real file with:
#   docker run --rm amir20/dozzle:v10.9.0 generate admin \
#     --password '<choose-a-strong-password>' \
#     --email 'you@example.com' \
#     --name 'Admin'
#
# Then set `roles: none` so the account can view logs without container actions.
# Full steps: docs/DOZZLE.md
users:
  admin:
    email: you@example.com
    name: Admin
    password: REPLACE_WITH_BCRYPT_HASH
    filter:
    roles: none
