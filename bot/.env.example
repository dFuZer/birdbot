# Optional jklm account auth (leave empty for guest hosting via creatorUserToken)
JKLM_AUTH_TOKEN=
JKLM_AUTH_USERNAME=
JKLM_AUTH_EXPIRATION=2982251755416
JKLM_NICKNAME=BirdBot
JKLM_LANGUAGE=en-US

# BirdBot API
API_URL=http://localhost:4000
API_KEY=SECRET_KEY_HERE_123456789

# Chat moderation (comma-separated lists; set a list to an empty value to disable it)
BIRDBOT_MODERATION_ENABLED=true
BIRDBOT_MODERATION_BANNED_NICKNAME_WORDS=nigger,nigga,hitler,nazi,kkk
BIRDBOT_MODERATION_BANNED_NICKNAME_CHARS=卐,卍
BIRDBOT_MODERATION_SPAM_WINDOW_MS=5000
BIRDBOT_MODERATION_SOFT_MESSAGE_LIMIT=5
BIRDBOT_MODERATION_HARD_MESSAGE_LIMIT=8
BIRDBOT_MODERATION_TEMP_BAN_MS=10000

# Definitions socket (defs.opnm.net — optional overrides)
# DEFS_SOCKET_URL=https://defs.opnm.net:443
# DEFS_AUTH_TOKEN=

# Ops notes:
# - Put jklm auth ids in ./admins.txt for /reconnect /health /givecredits /givexp /setxp /suppress
# - See ../BBV7_PARITY.md for command alias contracts and intentional divergences
