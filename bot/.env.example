# Optional jklm account auth (leave empty for guest hosting via creatorUserToken)
JKLM_AUTH_TOKEN=
JKLM_AUTH_USERNAME=
JKLM_AUTH_EXPIRATION=2982251755416
JKLM_NICKNAME=BirdBot
JKLM_LANGUAGE=en-US

# BirdBot API
API_URL=http://localhost:4000
API_KEY=SECRET_KEY_HERE_123456789

# Chat moderation (comma-separated lists; set a list to an empty value to disable it)
BIRDBOT_MODERATION_ENABLED=true
# Defaults match BBV7 when unset: nigg,lurk,pussy + unicode spam glyphs
# BIRDBOT_MODERATION_BANNED_NICKNAME_WORDS=nigg,lurk,pussy
# BIRDBOT_MODERATION_BANNED_NICKNAME_CHARS=
BIRDBOT_MODERATION_TEMP_BAN_MS=10000

# Definitions socket (defs.opnm.net — optional overrides)
# DEFS_SOCKET_URL=https://defs.opnm.net:443
# DEFS_AUTH_TOKEN=

# Ops notes:
# - Admins and automods live in Postgres (bot_staff). Seeded admin: dfuzer. Manage via /staff.
# - Rooms persist in bot_room and are rejoined on boot.
# - See ../BBV7_PARITY.md for command alias contracts and intentional divergences
# - Apply api Prisma migration 6_safety_catchup before relying on staff/rooms/ban audit

# Namespace UUID
NAMESPACE_UUID=aba77089-9d04-4817-9bd3-b9883b75bebf
