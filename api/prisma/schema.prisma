generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DB_URL")
}

enum Language {
    FR
    EN
    DE
    ES
    BRPT
    IT

    @@map("language")
}

enum GameMode {
    REGULAR
    EASY
    BLITZ
    SUB500
    SUB50
    FREEPLAY

    @@map("game_mode")
}

enum SubmitResultType {
    SUCCESS
    FAILS_PROMPT
    INVALID_WORD
    NO_TEXT
    ALREADY_USED
    BOMB_EXPLODED

    @@map("submit_result_type")
}

enum MilestoneType {
    SPEED
    ACCURACY

    @@map("milestone_type")
}

enum VipTier {
    NONE
    VIP
    VIP_PLUS

    @@map("vip_tier")
}

enum BotStaffRole {
    ADMIN
    AUTOMOD

    @@map("bot_staff_role")
}

model PlayerUsername {
    id String @id @default(uuid()) @db.Uuid

    player_id String @db.Uuid

    username   String   @db.VarChar(50)
    created_at DateTime @default(now())

    player Player @relation(fields: [player_id], references: [id])

    @@map("player_username")
}

model Player {
    id         String   @id @default(uuid()) @db.Uuid
    created_at DateTime @default(now())

    account_name String
    xp           Int    @default(0)

    metadata Json @default("{}")

    words        Word[]
    usernames    PlayerUsername[]
    gameRecaps   GameRecap[]
    websiteUsers WebsiteUserToPlayer[]
    milestones   PlayerMilestone[]
    creditAccount CreditAccount?
    creditLedger CreditLedger[]
    vipEntitlements VipEntitlement[]
    purchases    Purchase[]
    cosmetics    PlayerCosmetics?
    moderationState ModerationState?
    xpLedger     XpLedger[]

    @@map("player")
}

model Game {
    id         String    @id @default(uuid()) @db.Uuid
    started_at DateTime  @default(now())
    ended_at   DateTime?

    language   Language
    mode       GameMode
    words      Word[]
    gameRecaps GameRecap[]

    @@map("game")
}

model GameRecap {
    id String @id @default(uuid()) @db.Uuid

    game_id   String @db.Uuid
    player_id String @db.Uuid

    died_at                          DateTime
    words_count                      Int
    flips_count                      Int
    depleted_syllables_count         Int
    alpha_count                      Int
    words_without_death_count        Int
    previous_syllables_count         Int
    multi_syllables_count            Int
    hyphen_words_count               Int
    more_than_20_letters_words_count Int

    slurs_count     Int @default(0)
    creatures_count Int @default(0)
    ethnonyms_count Int @default(0)
    chemicals_count Int @default(0)
    plants_count    Int @default(0)
    adverbs_count   Int @default(0)
    foods_count     Int @default(0)

    game   Game   @relation(fields: [game_id], references: [id])
    player Player @relation(fields: [player_id], references: [id])

    @@unique([game_id, player_id])
    @@map("game_recap")
}

model Word {
    id         String   @id @default(uuid()) @db.Uuid
    created_at DateTime @default(now())

    player_id String @db.Uuid
    game_id   String @db.Uuid

    word            String           @db.VarChar(50)
    flip            Boolean
    submit_result   SubmitResultType
    prompt          String           @db.VarChar(10)
    duration_ms     Int?
    reaction_ms     Int?
    idempotency_key String           @unique @db.VarChar(140)

    player Player @relation(fields: [player_id], references: [id])
    game   Game   @relation(fields: [game_id], references: [id])

    @@map("word")
}

model PlayerMilestone {
    id              String        @id @default(uuid()) @db.Uuid
    player_id       String        @db.Uuid
    type            MilestoneType
    language        Language
    mode            GameMode
    category        String        @db.VarChar(40)
    milestone       Int
    value           Float
    achieved_at     DateTime      @default(now())
    source          String?       @db.VarChar(80)
    idempotency_key String        @unique @db.VarChar(120)
    metadata        Json          @default("{}")

    player Player @relation(fields: [player_id], references: [id])

    @@unique([player_id, type, language, mode, category, milestone])
    @@index([type, language, mode, category, milestone, value])
    @@index([player_id, type, language, mode])
    @@map("player_milestone")
}

model CreditAccount {
    player_id String   @id @db.Uuid
    balance   Int      @default(0)
    updated_at DateTime @updatedAt

    player Player @relation(fields: [player_id], references: [id])

    @@map("credit_account")
}

model CreditLedger {
    id              String   @id @default(uuid()) @db.Uuid
    player_id       String   @db.Uuid
    amount          Int
    balance_after   Int
    reason          String   @db.VarChar(120)
    reference       String?  @db.VarChar(160)
    idempotency_key String   @unique @db.VarChar(140)
    actor           String   @db.VarChar(80)
    metadata        Json     @default("{}")
    created_at      DateTime @default(now())

    player Player @relation(fields: [player_id], references: [id])

    @@index([player_id, created_at])
    @@map("credit_ledger")
}

model XpLedger {
    id              String   @id @default(uuid()) @db.Uuid
    player_id       String   @db.Uuid
    amount          Int
    xp_after        Int
    operation       String   @db.VarChar(12)
    reason          String   @db.VarChar(120)
    idempotency_key String   @unique @db.VarChar(140)
    actor           String   @db.VarChar(80)
    metadata        Json     @default("{}")
    created_at      DateTime @default(now())

    player Player @relation(fields: [player_id], references: [id])

    @@index([player_id, created_at])
    @@map("xp_ledger")
}

model VipEntitlement {
    id              String   @id @default(uuid()) @db.Uuid
    player_id       String   @db.Uuid
    tier            VipTier  @default(NONE)
    starts_at       DateTime @default(now())
    expires_at      DateTime?
    granted_by      String   @db.VarChar(80)
    reason          String?  @db.VarChar(240)
    idempotency_key String   @unique @db.VarChar(120)
    updated_at      DateTime @updatedAt

    player Player @relation(fields: [player_id], references: [id])

    @@index([player_id, starts_at])
    @@map("vip_entitlement")
}

model Purchase {
    id               String   @id @default(uuid()) @db.Uuid
    player_id        String   @db.Uuid
    sku              String   @db.VarChar(120)
    credits_spent    Int
    external_reference String? @unique @db.VarChar(160)
    idempotency_key  String   @unique @db.VarChar(120)
    actor            String   @db.VarChar(80)
    metadata         Json     @default("{}")
    purchased_at     DateTime @default(now())

    player Player @relation(fields: [player_id], references: [id])

    @@index([player_id, purchased_at])
    @@map("purchase")
}

model PlayerCosmetics {
    player_id      String   @id @db.Uuid
    welcome_message String? @db.VarChar(500)
    room_name      String?  @db.VarChar(100)
    bot_name       String?  @db.VarChar(80)
    picture_url    String?  @db.Text
    updated_by     String   @db.VarChar(80)
    updated_at     DateTime @updatedAt

    player Player @relation(fields: [player_id], references: [id])

    @@map("player_cosmetics")
}

model ModerationState {
    player_id         String   @id @db.Uuid
    trust_score       Int      @default(0)
    blacklisted       Boolean  @default(false)
    blacklist_reason  String?  @db.VarChar(500)
    suppressed        Boolean  @default(false)
    suppress_reason   String?  @db.VarChar(500)
    updated_by        String   @db.VarChar(80)
    updated_at        DateTime @updatedAt

    player Player @relation(fields: [player_id], references: [id])

    @@map("moderation_state")
}

model NewsEntry {
    id              String   @id @default(uuid()) @db.Uuid
    title           String   @db.VarChar(160)
    body            String
    published       Boolean  @default(false)
    published_at    DateTime?
    created_by      String   @db.VarChar(80)
    updated_by      String   @db.VarChar(80)
    idempotency_key String   @unique @db.VarChar(120)
    created_at      DateTime @default(now())
    updated_at      DateTime @updatedAt

    @@index([published, published_at])
    @@map("news_entry")
}

model WebsiteSession {
    id String @id @default(uuid()) @db.Uuid

    session_token   String @unique
    website_user_id String @db.Uuid

    user WebsiteUser @relation(fields: [website_user_id], references: [id])

    @@map("website_session")
}

model WebsiteUser {
    id String @id @default(uuid()) @db.Uuid

    oauth_identifier  String @unique
    oauth_username    String
    oauth_global_name String
    oauth_avatar      String?
    oauth_provider    String

    WebsiteSession           WebsiteSession[]
    WebsiteUserToPlayer      WebsiteUserToPlayer?
    WebsiteUserToPlayerToken WebsiteUserToPlayerToken?

    @@map("website_user")
}

model WebsiteUserToPlayer {
    player_id       String @unique @db.Uuid
    website_user_id String @unique @db.Uuid

    player       Player      @relation(fields: [player_id], references: [id])
    website_user WebsiteUser @relation(fields: [website_user_id], references: [id])

    @@map("website_user_to_player")
}

model WebsiteUserToPlayerToken {
    id String @id @default(uuid()) @db.Uuid

    token           String @unique
    website_user_id String @unique @db.Uuid

    website_user WebsiteUser @relation(fields: [website_user_id], references: [id])

    @@map("website_user_to_player_token")
}

model BotStaff {
    account_name String       @db.VarChar(120)
    role         BotStaffRole
    updated_by   String       @db.VarChar(80)
    updated_at   DateTime     @updatedAt
    created_at   DateTime     @default(now())

    @@id([account_name, role])
    @@map("bot_staff")
}

model BotRoom {
    room_code       String   @id @db.VarChar(16)
    user_token      String   @db.VarChar(120)
    server_url      String?  @db.VarChar(500)
    creator_auth_id String?  @db.VarChar(120)
    target_config   Json
    updated_at      DateTime @updatedAt
    created_at      DateTime @default(now())

    @@map("bot_room")
}

model BanEvent {
    id                  String   @id @default(uuid()) @db.Uuid
    player_account      String   @db.VarChar(120)
    room_code           String   @db.VarChar(16)
    moderator_accounts  String[]
    created_at          DateTime @default(now())

    @@index([room_code, created_at])
    @@index([player_account, created_at])
    @@map("ban_event")
}
